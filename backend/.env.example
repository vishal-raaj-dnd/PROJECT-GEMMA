# ==============================================================================
# FIELD ENGINEERING & HARDWARE DIAGNOSTIC ENGINE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Google GenAI / Gemma API Key
# Obtain from https://aistudio.google.com/
GEMMA_API_KEY=your_gemini_or_gemma_api_key_here

# Gemma / Gemini Model Identifier
# Supported: gemini-2.5-flash, gemini-2.0-flash, or a local Gemma endpoint
GEMMA_MODEL=gemini-2.5-flash

# Knowledge Base & Storage Paths (Relative or Absolute)
OKF_STORAGE_DIR=./data/okf_bundle
RAW_DOCS_DIR=./data/raw_docs

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Frontend CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Safety Compliance Mode (strict = blocks procedural steps without LOTO signoff)
STRICT_SAFETY_GATE=true
