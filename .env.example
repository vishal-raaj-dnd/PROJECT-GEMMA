# Google Gemma / Gemini API Key (Multimodal Vision & Diagnosis Reasoning)
GEMMA_API_KEY=your_gemini_or_gemma_api_key_here

# Selected Gemma Model (Official Google Gemma 4 Multimodal Model)
GEMMA_MODEL=gemma-4-26b-a4b-it

# Logging Level
LOG_LEVEL=INFO

# Optional: Frontend API URL (leave blank on Vercel all-in-one deploy, or set to your custom backend domain)
# VITE_API_URL=https://your-custom-backend.onrender.com

